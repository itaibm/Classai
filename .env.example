# Classai configuration. Copy to `.env`. Everything has a sane default —
# you can run the app with this file empty and connect your AI brain from the UI.

# HTTP port for the server (also serves the built client in production).
PORT=8787

# Where Classai stores its SQLite database and local auth profiles.
# Defaults to ./data next to the repo. This directory is git-ignored.
CLASSAI_DATA_DIR=./data

# Parent gate PIN. Protects the parent portal (kid setup, curriculum, reports).
# If unset, the first parent to open the app sets it.
# CLASSAI_PARENT_PIN=1234

# ---------------------------------------------------------------------------
# AI brain credentials are NOT configured here. Classai never bakes in a
# developer key. Each user connects their OWN brain from the "Connect your
# brain" screen, and credentials are stored locally in
# $CLASSAI_DATA_DIR/auth-profiles.json (git-ignored), following OpenClaw's model:
#   - Anthropic : your own API key, or reuse your local Claude login
#   - OpenAI    : your own API key, or "Sign in with ChatGPT" (OAuth + PKCE)
#   - Local     : a free local model via Ollama (OpenAI-compatible, no key)
# ---------------------------------------------------------------------------

# Optional: enables real teaching-video search (YouTube Data API v3).
# Without it, lessons use generated visuals only and the video block is disabled.
# Note: when set, a video search query (e.g. "water cycle for kids") is sent to YouTube.
YOUTUBE_API_KEY=
